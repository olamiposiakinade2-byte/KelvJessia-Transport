# PostgreSQL only. Never expose this value to browser code.
DATABASE_URL="postgresql://oladb_user:change-me@localhost:5432/oladb?schema=public"
# Single administrator; generate this with: npm run password:hash -- "your password"
OLADB_ADMIN_EMAIL="admin@example.test"
OLADB_ADMIN_PASSWORD_HASH=""
# Generate a high-entropy value, at least 32 characters.
SESSION_SECRET=""
# Set true only after a successful local migration and seed.
OLADB_ALLOW_DEMO_SEED="false"

# Transport payment migration remains disconnected from the public website.
# Set these only in a protected OlaDB staging environment and only with sk_test_.
OLADB_TRANSPORT_MODE="demo"
OLADB_STAGING_PROTECTED="false"
OLADB_PAYSTACK_TEST_MODE="false"
PAYSTACK_SECRET_KEY=""
PAYSTACK_CALLBACK_URL=""
