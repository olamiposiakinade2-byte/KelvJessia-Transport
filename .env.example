# Server-only. Copy to Vercel Preview/Development environment settings; never
# place these values in dist/, NEXT_PUBLIC_ variables, or source control.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
BOOKING_RATE_LIMIT_SALT=generate-a-long-random-secret
KELVJESSIA_BOOKINGS_MODE=staging
KELVJESSIA_STAGING_PROTECTED=true

# Test-mode only. Do not set a live Paystack key until formal approval.
KELVJESSIA_PAYMENTS_TEST_MODE=true
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=https://your-protected-preview.example/payment.html

# Required when Turnstile is used for public staged forms.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret

# Used by an authenticated staging scheduler to expire unpaid reservations.
# The default Vercel Hobby deployment does not configure a cron job.
CRON_SECRET=generate-a-separate-long-random-secret

# Render API payment test mode. Add these in Render's encrypted environment
# settings only. The server rejects production payment keys.
KELVJESSIA_PAYMENTS_TEST_MODE=true
KELVJESSIA_ADMIN_TOKEN=generate-a-separate-32-character-or-longer-secret
